# --- INFRAESTRUCTURA ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Admin123
POSTGRES_DB=eps_db

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=Admin123

# --- CONEXIÓN PARA SERVICIOS (DENTRO DE DOCKER) ---
# Usamos los nombres definidos en el docker-compose
# DB_HOST=postgres-eps-db
# DB_PORT=5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=Admin123
DB_NAME=eps_db

RABBIT_HOST=rabbitmq-eps-broker
RABBIT_PORT=5672
RABBIT_USER=admin
RABBIT_PASS=Admin123

# --- CONFIGURACIÓN DE NEGOCIO ---
QUEUE_NAME_MEDICION_REGISTRADA=medicion.registrada
TRAINING_DATASET_FILE=dataset_entrenamiento_eps_96000.csv
IA_PORT=8000

# --- CONFIGURACIÓN PARA API DE INGESTA ---
INGESTA_PORT=5000
RABBITMQ_URL=amqp://${RABBIT_USER}:${RABBIT_PASS}@${RABBIT_HOST}:${RABBIT_PORT}

SIMULATOR_ENABLED=true
SIMULATOR_TOKEN=sidi-local-prueba-2026
